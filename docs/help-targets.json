{
  "_about": "2.1086.0 (#5860): the named places of the app that an agent may point at with \"Show me\" (send_chat show: [{target, text}]). key -> route (the hash the app opens first, null = stay on the current screen, e.g. inside a dialog the person opens), sel (CSS selectors, comma separated: the first one visible on the screen is highlighted), label_en (the card's heading, translated in static/i18n). The server accepts only these keys (kalmido/api/showme.py); a help section names its places with one <!-- show: key --> line each under its heading (the steps of its \"Show me\" button, 2.1090.0 #5899). Never an action: the app only goes to the route and highlights.",
  "targets": {
    "settings.open": {"route": null, "sel": "#side .sset, #tabs [data-act=\"tabs-more\"], #tabs [data-act=\"settings\"], #top .menu", "label_en": "Open the settings"},
    "settings.integrations": {"route": null, "sel": ".modal .snav [data-sec=\"integr\"]", "label_en": "Settings: Integrations"},
    "settings.agents": {"route": null, "sel": ".modal .snav [data-sec=\"ai\"]", "label_en": "Settings: Agents"},
    "files.scan-inbox": {"route": null, "sel": ".modal .icard[data-jump=\"#s-scan-h\"], .modal [data-intr] .dsc-new summary", "label_en": "Documents: inboxes (scan inbox)"},
    "agents.add": {"route": "#agents", "sel": "#view [data-act=\"ag-setup\"]", "label_en": "Add an agent"},
    "agents.settings": {"route": "#agents", "sel": "#view [data-act=\"ag-set\"]", "label_en": "Settings of the agent"},
    "office.offer-new": {"route": "#office/offers", "sel": "#view [data-ofd=\"new\"]", "label_en": "New quotation"},
    "office.invoice-new": {"route": "#office/invoices", "sel": "#view [data-ofd=\"new-inv\"]", "label_en": "New invoice"},
    "tasks.new": {"route": "#today", "sel": "#view .qadd .box, #fab", "label_en": "Add a task"},
    "calendar.new": {"route": "#cal", "sel": "#view [data-act=\"ev-new\"]", "label_en": "New event"},
    "files.upload": {"route": "#ablage", "sel": "#view [data-ab=\"upload\"]", "label_en": "Upload files"},
    "files.documents-add": {"route": "#ablage/docs", "sel": "#view .dc-up", "label_en": "Add documents"},
    "wiki.new": {"route": "#wiki", "sel": "#view [data-wk=\"new\"]", "label_en": "New page"},
    "sheets.new": {"route": "#sheets", "sel": "#view [data-shv=\"new\"]", "label_en": "New table"},
    "team.new": {"route": "#team", "sel": "#view [data-act=\"tc-new\"]", "label_en": "New message"},
    "budget.create": {"route": "#budget", "sel": "#view [data-bg=\"create\"]", "label_en": "Create a budget"}
  }
}
