# Copy to .env and adjust. Everything except TZ and PUBLIC_URL is optional.

# Time zone for due dates, reminders and the daily digest
TZ=Europe/Berlin
# Address you open Kalmido at (used in links inside push notifications)
PUBLIC_URL=https://tasks.example.com

# --- Login. Default: built-in login (username + password, session cookie). On the first start
# Kalmido shows a setup page that creates the first admin; further users are added in Settings > Users.
#
# Optional single sign-on behind an authenticating reverse proxy (Authelia, Authentik, oauth2-proxy):
# the proxy sends the user name in a header, Kalmido maps it to the user whose "SSO login" matches.
# SECURITY: the header is only trusted from AUTH_TRUSTED_PROXIES (IPs/CIDRs of the DIRECT peer), and
# your proxy MUST strip client-sent copies of this header (see README). Behind Docker's port
# publishing every host / container connection arrives from the Docker bridge gateway IP, so also
# set AUTH_PROXY_PORT: the header is then only honoured on that extra container port, which you map
# to the address only your proxy uses.
#AUTH_PROXY_HEADER=Remote-User
#AUTH_TRUSTED_PROXIES=127.0.0.1
#AUTH_PROXY_PORT=3045
# Upgrading from the single-user version: the existing data goes to this admin. It has no password:
# set AUTH_BOOTSTRAP_PROXY_LOGIN for SSO, or run once
#   docker exec -it kalmido python app.py set-password admin
#AUTH_BOOTSTRAP_USER=admin
#AUTH_BOOTSTRAP_NAME=Admin
#AUTH_BOOTSTRAP_PROXY_LOGIN=
# Days a "stay logged in" session lasts
#AUTH_SESSION_DAYS=30
# Reverse proxies whose X-Forwarded-For / -Proto / -Host Kalmido believes (IPs / CIDRs of the DIRECT peer, comma list;
# the AUTH_TRUSTED_PROXIES peers count too). Kalmido then sees the client's real address (failed-login lockouts per
# address, logs, alerts) and https (cookies, CalDAV). Default: loopback + the Docker bridge gateway, which covers a
# proxy on the same host (also one reaching a published port, it arrives from the gateway). A proxy in another
# container on a user-defined network arrives from that network's gateway (e.g. 172.18.0.1): add it. "none" = trust
# nobody (the direct peer is the client). KALMIDO_TRUSTED_PROXY_COUNT: proxies in a row (default 1).
#KALMIDO_TRUSTED_PROXIES=127.0.0.1,::1,172.17.0.1
#KALMIDO_TRUSTED_PROXY_COUNT=1

# --- Push notifications via ntfy (reminders, focus end, habits, daily digest)
# ntfy.sh works without an account; with your own ntfy server set URL + token.
# Every user has an own topic (Settings > Users, empty = random). NTFY_TOPIC seeds the first admin's topic.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# --- Upload endpoint POST /drop (e.g. Android app "HTTP Shortcuts" as a share target,
# several files per share). Header: Authorization: Bearer <token>. Every user has an own token
# (Settings > Account > Upload token); this variable becomes the first admin's token when set.
# Your proxy must let /drop through without its login; the token protects it.
TASKS_DROP_TOKEN=

# --- Share inbox via ntfy: every message on this topic becomes an inbox task.
# SECURITY: whoever can publish to the topic creates tasks (and attachments) in that inbox. Use your own
# ntfy with access control (read token for Kalmido) or an unguessable topic; on the public ntfy.sh a short /
# the default topic "inbox" is refused. Attachments are only fetched from this ntfy server.
NTFY_INBOX_URL=
NTFY_INBOX_PUBLIC=
NTFY_INBOX_TOPIC=inbox
NTFY_INBOX_TOKEN=
# user (username) whose inbox receives these tasks; empty = the first admin
NTFY_INBOX_USER=

# --- Paperless-ngx: link documents to tasks, send attachments to Paperless.
# One token for everyone: only users an admin allows (Settings > Users > Paperless access; admins by
# default) can search / link / upload; they see the whole archive of this token's Paperless account.
PAPERLESS_API=
PAPERLESS_PUBLIC_URL=
PAPERLESS_TOKEN=
# 2.1.0: more Paperless connections (admins: Settings > Users > Paperless connections; everyone: their own under
# Settings > Integrations) store each user's own API token, encrypted with this key: 32 random bytes, base64
# (openssl rand -base64 32). Without it no token can be stored. Keep a copy outside the server: if the key is lost,
# everyone has to enter their tokens again. It is never written to the database or a backup.
KALMIDO_SECRET_KEY=

# --- Image: empty = build locally (docker compose up -d --build); or a prebuilt one:
#KALMIDO_IMAGE=ghcr.io/gegenschuss/kalmido:2.5.0

# --- Update check: every 6 hours the server asks GitHub for the latest release (admins see it in
# Settings > Help; nothing is installed automatically). 0 = never ask.
#KALMIDO_UPDATE_CHECK=1
# 2.29.0: 1 = search engines may index the sign-in page (default: noindex everywhere, robots.txt Disallow: /)
#KALMIDO_SEARCH_INDEX=0

# --- Share from your phone (Settings > Integrations): link to a signed generic iOS shortcut that asks for the
# address and the upload token on import. Empty = the button is hidden.
#KALMIDO_IOS_SHORTCUT_URL=

# --- Admin alerts via ntfy (Settings > Users > Whole server > Admin alerts): update available, delivery problems,
# watchdog errors, integrations, security events, disk space -> the admins' ntfy topics. 0 = off completely;
# KALMIDO_ADMIN_TOPIC = one fixed topic for all admin alerts instead of each admin's own.
#KALMIDO_ADMIN_ALERTS=1
#KALMIDO_ADMIN_TOPIC=

# --- Calendar subscriptions (Settings > Integrations > Calendars): events from ICS links / CalDAV servers next to the
# tasks. Fetches refuse private / internal addresses (SSRF guard); list trusted internal calendar servers here
# (host or host:port, comma-separated) or under Settings > Users > Whole server. 0 = feature off.
#KALMIDO_CALENDARS=1
#KALMIDO_CALENDAR_ALLOW_HOSTS=nextcloud.home.arpa, 10.0.0.20:5232
#KALMIDO_CALENDAR_MAX_MB=10
#KALMIDO_CALENDAR_MAX_EVENTS=5000
#KALMIDO_CALENDAR_RATE=30

# --- Limits
TASKS_MAX_FILE_MB=50
# comments / assignments / completions: further pushes about the same task within this many seconds
# are bundled into one summary push
#TASKS_PUSH_GAP=60

# --- Backups (Settings > Users > Whole server > Backups): daily archive of the database + attachments, restore in the
# app. 0 = feature off. The passphrase (optional) encrypts them; WITHOUT IT AN ENCRYPTED BACKUP CANNOT BE RESTORED.
#KALMIDO_BACKUPS=1
#KALMIDO_BACKUP_DIR=/data/backups
#KALMIDO_BACKUP_PASSPHRASE=
#KALMIDO_BACKUP_MAX_MB=4096

# --- Passkeys (WebAuthn): the RP ID is the host of PUBLIC_URL. Several hosts under one domain: set the domain here and
# list the extra origins.
#KALMIDO_WEBAUTHN_RP_ID=example.com
#KALMIDO_WEBAUTHN_ORIGINS=https://tasks.example.net

# --- Log in with an OpenID Connect provider (Authentik, Keycloak, Authelia, PocketID, Google, Microsoft Entra, ...).
# Redirect URI to register at the provider: <PUBLIC_URL>/api/auth/oidc/callback. Issuer + client id turn it on. Since 2.9.0
# also in Settings > Administration > Sign-in; a variable set here wins for its field. Guides: docs/OIDC.md
#KALMIDO_OIDC_ISSUER=https://auth.example.com
#KALMIDO_OIDC_CLIENT_ID=kalmido
#KALMIDO_OIDC_CLIENT_SECRET=
#KALMIDO_OIDC_BUTTON_LABEL=Authentik
#KALMIDO_OIDC_SCOPES=openid profile email
#KALMIDO_OIDC_USERNAME_CLAIM=preferred_username
#KALMIDO_OIDC_GROUPS_CLAIM=groups
#KALMIDO_OIDC_REQUIRED_GROUP=
#KALMIDO_OIDC_ADMIN_GROUP=
# a verified e-mail of one of these domains makes the person an admin (comma list)
#KALMIDO_OIDC_ADMIN_DOMAINS=
# a provider in your own network (private address) must be allowed explicitly (host or host:port)
#KALMIDO_OIDC_ALLOW_HOSTS=

# --- Calendar apps (CalDAV, 2.9.0): /dav/ with user name + app password, see docs/CALDAV.md. Behind a login proxy let
# /dav and /.well-known/caldav bypass it. 0 = off; completed tasks stay N days in the apps; HTTP=1 allows logins while
# PUBLIC_URL is plain http:// (trusted networks only).
#KALMIDO_CALDAV=1
#KALMIDO_CALDAV_DONE_DAYS=90
#KALMIDO_CALDAV_HTTP=0

# REST API (/api/v1, personal access tokens) and webhooks, see docs/API.md. 0 = off.
#KALMIDO_API=1
#KALMIDO_API_RATE=120
#KALMIDO_WEBHOOKS=1
# 2.2.1: days the agents' activity log (every request with an agent token) is kept; 0 = no log
#KALMIDO_AUDIT_DAYS=90
# internal hosts webhooks may reach (in addition to "Allowed internal hosts" in the app); only these may use http://
#KALMIDO_WEBHOOK_ALLOW_HOSTS=n8n.home.arpa, 10.0.0.30:5678

# public list links (/s/<token>): 0 = off for good; views per address and minute; views of one link in 10 min -> admin alert
#KALMIDO_PUBLIC_LINKS=1
#KALMIDO_PUBLIC_RATE=60
#KALMIDO_PUBLIC_BURST=300

# --- 2.17.0: new tasks by e-mail (one mailbox Kalmido polls; everyone gets a secret address tasks+<token>@example.com,
# so the mailbox / provider must deliver plus addresses to it) and the daily summary by e-mail (SMTP). See README "Tasks by e-mail".
#KALMIDO_MAIL_ADDRESS=tasks@example.com
#KALMIDO_IMAP_HOST=imap.example.com
#KALMIDO_IMAP_PORT=993
#KALMIDO_IMAP_SSL=1
#KALMIDO_IMAP_USER=tasks@example.com
#KALMIDO_IMAP_PASSWORD=
#KALMIDO_IMAP_FOLDER=INBOX
#KALMIDO_IMAP_INTERVAL=60
#KALMIDO_SMTP_HOST=smtp.example.com
#KALMIDO_SMTP_PORT=587
#KALMIDO_SMTP_TLS=starttls
#KALMIDO_SMTP_USER=tasks@example.com
#KALMIDO_SMTP_PASSWORD=
#KALMIDO_MAIL_FROM=tasks@example.com
